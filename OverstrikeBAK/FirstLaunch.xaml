<Window x:Class="OverstrikeBAK.FirstLaunch"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:local="clr-namespace:OverstrikeBAK"
		xmlns:utils="clr-namespace:OverstrikeBAK.Utils"
		Title="Overstrike-BAK" Height="422" MinHeight="422" MaxHeight="422" Width="600" MinWidth="600" MaxWidth="600" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" Icon="pack://application:,,,/Properties/Resources/icon.ico">

	<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
		<Grid>
			<TextBlock Text="Welcome!" FontWeight="Bold" VerticalAlignment="Top" Margin="10,10,10,0" />
			<TextBlock Text="Looks like this is your first time here." VerticalAlignment="Top" Margin="10,34,10,0" />
			<TextBlock Text="To start, you need to create a profile." VerticalAlignment="Top" Margin="10,58,10,0" />
			<TextBlock Text="A profile is a small text file that stores which mods are enabled and your suit order." VerticalAlignment="Top" Margin="10,82,10,0" />
			<TextBlock Text="You can create multiple profiles for the same game and switch between them at any time." VerticalAlignment="Top" Margin="10,99,10,0" />

			<Grid Height="214" Margin="7,136,7,0" VerticalAlignment="Top">
				<Grid.RowDefinitions>
					<RowDefinition Height="28" />
					<RowDefinition Height="152" />
					<RowDefinition Height="34" />
				</Grid.RowDefinitions>

				<Border BorderThickness="1,1,1,0" Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}">
					<Grid>
						<TextBlock Text="Profile name" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Left" Margin="40,5,0,0" VerticalAlignment="Top" />
						<TextBlock Text="Game path" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Left" Margin="230,5,0,0" VerticalAlignment="Top" />
					</Grid>
				</Border>

				<utils:ListViewEx Grid.Row="1" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource BorderBrush}" Padding="0,0,1,0"
							x:Name="ProfilesList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
							SelectionMode="Single" Height="150" ItemContainerStyle="{StaticResource ListItem}" VerticalAlignment="Top">
					<ListView.Resources>
						<DataTemplate DataType="{x:Type local:FirstLaunchProfile}">
							<Grid Height="26">
								<CheckBox IsChecked="{Binding Create}" HorizontalAlignment="Left" Margin="4,6,0,0" VerticalAlignment="Top" />
								<TextBlock Text="{Binding Name}" HorizontalAlignment="Left" Margin="34,5,0,0" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Top" />
								<TextBlock Text="{Binding GamePath}" ToolTip="{Binding GamePath}" HorizontalAlignment="Left" Margin="224,5,0,0" VerticalAlignment="Top" />
							</Grid>
						</DataTemplate>
					</ListView.Resources>
				</utils:ListViewEx>

				<Grid Grid.Row="2">
					<TextBlock x:Name="Hint" Text="Batman: Arkham Knight wasn't found in the usual places. Please, add it manually:" VerticalAlignment="Top" Margin="3,8,130,0" TextTrimming="CharacterEllipsis" />
					<Button Content="Add game" Margin="3,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Click="AddGameButton_Click" />
				</Grid>
			</Grid>

			<Grid VerticalAlignment="Bottom" Margin="5,0,5,5">
				<Button x:Name="CreateProfilesButton" Content="Create profiles" Style="{StaticResource AccentButton}" IsEnabled="False" HorizontalAlignment="Right" Margin="0,0,2,5" VerticalAlignment="Bottom" Width="120" Click="CreateProfilesButton_Click" />
			</Grid>
		</Grid>
	</Border>
</Window>
