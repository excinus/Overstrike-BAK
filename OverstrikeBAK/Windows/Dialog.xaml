<Window x:Class="OverstrikeBAK.Windows.Dialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Overstrike-BAK" SizeToContent="WidthAndHeight" MinWidth="320" MaxWidth="560" ResizeMode="NoResize" ShowInTaskbar="False"
		WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Margin="18,18,22,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition />
			</Grid.ColumnDefinitions>
			<TextBlock x:Name="IconGlyph" Grid.Column="0" FontFamily="Segoe MDL2 Assets" FontSize="26" Margin="0,0,14,0" VerticalAlignment="Top" />
			<TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" LineHeight="19" />
		</Grid>

		<Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10">
			<StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right" />
		</Border>
	</Grid>
</Window>
