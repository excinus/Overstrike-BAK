<Window x:Class="OverstrikeBAK.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:utils="clr-namespace:OverstrikeBAK.Utils"
		xmlns:tabs="clr-namespace:OverstrikeBAK.Tabs"
		xmlns:data="clr-namespace:OverstrikeBAK.Data"
		Title="Overstrike-BAK" Height="740" Width="1080" MinWidth="1060" MinHeight="560" WindowStartupLocation="CenterScreen"
		Icon="pack://application:,,,/Properties/Resources/icon.ico"
		Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
		KeyUp="Window_KeyUp" Closing="Window_Closing">
	<Window.Resources>
		<Storyboard x:Key="ShowStatusMessage">
			<DoubleAnimation Storyboard.TargetName="StatusMessage" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
			<DoubleAnimation Storyboard.TargetName="StatusMessage" Storyboard.TargetProperty="Opacity" From="1" To="0" BeginTime="0:0:4" Duration="0:0:0.4" />
		</Storyboard>

		<Storyboard x:Key="ShowStatusMessageError">
			<DoubleAnimation Storyboard.TargetName="StatusMessage" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
		</Storyboard>

		<Storyboard x:Key="HideStatusMessage">
			<DoubleAnimation Storyboard.TargetName="StatusMessage" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
		</Storyboard>

		<Style x:Key="SettingLabel" TargetType="{x:Type TextBlock}">
			<Setter Property="Width" Value="150" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
		</Style>

		<Style x:Key="SettingRow" TargetType="{x:Type StackPanel}">
			<Setter Property="Orientation" Value="Horizontal" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="76" />
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>

		<!-- operations in progress -->
		<Grid x:Name="Overlay" Grid.RowSpan="3" Panel.ZIndex="1000" Visibility="Collapsed" Background="{DynamicResource OverlayBrush}">
			<Border VerticalAlignment="Center" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,1,0,1" Padding="26,16">
				<StackPanel>
					<TextBlock x:Name="OverlayHeaderLabel" Text="Working..." FontSize="18" FontFamily="Bahnschrift SemiBold Condensed, Segoe UI" TextTrimming="CharacterEllipsis" />
					<TextBlock x:Name="OverlayOperationLabel" Text="" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
				</StackPanel>
			</Border>
		</Grid>

		<!-- banner -->
		<Grid Grid.Row="0" Background="#000000" ClipToBounds="True">
			<Image Source="Properties/Resources/banner_logo.png" Height="58" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
			<Image Source="Properties/Resources/banner_batman.png" Height="76" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
		</Grid>

		<!-- profile -->
		<Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Profile" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,8,0" />
				<ComboBox x:Name="ProfileComboBox" Width="230" Height="24" SelectionChanged="ProfileComboBox_SelectionChanged">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Text}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
				<TextBlock x:Name="ProfileGamePath" Text="" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource FaintTextBrush}" Cursor="Hand"
						   ToolTip="Double-click: open the game folder. Right double-click: open the Overstrike-BAK folder." MouseLeftButtonDown="ProfileGamePath_MouseDown" MouseRightButtonDown="ProfileGamePath_MouseDown" />
			</StackPanel>
		</Border>

		<TabControl Grid.Row="2" x:Name="MainTabs" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
			<!-- MODS -->
			<TabItem Header="MODS" x:Name="ModsTab">
				<Grid Margin="10,8,10,8">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Grid Grid.Row="0" Margin="0,0,0,6">
						<StackPanel Orientation="Horizontal">
							<Grid Width="240" Height="24">
								<TextBox x:Name="FilterTextBox" TextChanged="FilterTextBox_TextChanged" />
								<TextBlock IsHitTestVisible="False" Text="Search..." VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource FaintTextBrush}">
									<TextBlock.Style>
										<Style TargetType="{x:Type TextBlock}">
											<Setter Property="Visibility" Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
													<Setter Property="Visibility" Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</Grid>
							<Button x:Name="CheckAllButton" Content="Check all" Width="96" Height="24" Margin="6,0,0,0" Click="CheckAllButton_Click" />
							<TextBlock x:Name="ModsCountLabel" Text="" Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
						</StackPanel>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<Button x:Name="SortButton" Height="24" Padding="10,0" Margin="0,0,6,0" Click="SortButton_Click">
								<Button.ContextMenu>
									<ContextMenu />
								</Button.ContextMenu>
								<StackPanel Orientation="Horizontal">
									<TextBlock x:Name="SortButtonLabel" Text="Sort by: Name" />
									<TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<Button x:Name="ModProfilesButton" Height="24" Padding="10,0" Margin="0,0,10,0" ToolTip="Save the ticks as a preset, or load one" Click="ModProfilesButton_Click">
								<Button.ContextMenu>
									<ContextMenu />
								</Button.ContextMenu>
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="Presets" />
									<TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<Button x:Name="AddMods" Style="{StaticResource IconButton}" Width="28" Height="24" ToolTip="Add mods" Click="AddMods_Click">
								<Button.ContextMenu>
									<ContextMenu>
										<MenuItem Header="Add archives (.zip, .7z, .rar)..." Click="AddArchives_Click" />
										<MenuItem Header="Add mod folders..." Click="AddFolders_Click" />
										<Separator />
										<MenuItem Header="Import mods from the game folder..." Click="ImportMods_Click" />
										<MenuItem Header="Open Mods Library folder" Click="OpenLibrary_Click" />
									</ContextMenu>
								</Button.ContextMenu>
								<TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
							</Button>
							<Button Style="{StaticResource IconButton}" Width="28" Height="24" Margin="2,0,0,0" ToolTip="Rescan the Mods Library" Click="RefreshButton_Click">
								<TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
							</Button>
						</StackPanel>
					</Grid>

					<Grid Grid.Row="1">
						<utils:ListViewEx x:Name="ModsList" BorderThickness="1" Padding="0"
										  VirtualizingStackPanel.VirtualizationMode="Recycling"
										  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
										  SelectionMode="Extended" ItemContainerStyle="{StaticResource ListItem}"
										  AllowDrop="True" DragEnter="ModsList_DragEnter" DragOver="ModsList_DragEnter" Drop="ModsList_Drop" KeyUp="ModsList_KeyUp">
							<ListView.Resources>
								<DataTemplate DataType="{x:Type data:ModEntry}">
									<Grid Height="28" Background="Transparent" ToolTip="{Binding ToolTip}">
										<Grid.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Open Nexus Mods page" Click="OpenNexus_Click" IsEnabled="{Binding HasNexus}" />
												<MenuItem Header="Set Nexus Mods page..." Click="SetNexus_Click" />
												<MenuItem Header="Update info from Nexus Mods" Click="RefreshNexus_Click" IsEnabled="{Binding HasNexus}" />
												<MenuItem Header="Remove Nexus Mods link" Click="RemoveNexus_Click" IsEnabled="{Binding HasNexus}" />
												<Separator />
												<MenuItem Header="{Binding ShowInMenuHeader}" Click="ShowInSuitsMenu_Click" Visibility="{Binding ShowInMenuVisibility}" IsEnabled="{Binding InstalledHere}"
														  ToolTip="{Binding ShowInMenuToolTip}" ToolTipService.ShowOnDisabled="True" />
												<MenuItem Header="Open folder" Click="OpenModFolder_Click" />
												<Separator />
												<MenuItem Header="Delete" Click="DeleteMod_Click" />
											</ContextMenu>
										</Grid.ContextMenu>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="78" />
											<ColumnDefinition />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>

										<CheckBox Grid.Column="0" IsChecked="{Binding Install}" HorizontalAlignment="Left" Margin="7,0,0,0" VerticalAlignment="Center" />

										<Border Grid.Column="0" Background="{Binding BadgeColor}" CornerRadius="2" Width="44" Height="15" Margin="29,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
											<TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
										</Border>

										<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0">
											<TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="NEXUS" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="8,1,0,0" VerticalAlignment="Center"
													   Visibility="{Binding NexusVisibility}" ToolTip="Linked to a Nexus Mods page (right-click to open it)" />
											<TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="7,1,0,0" VerticalAlignment="Center" Cursor="Hand"
													   Visibility="{Binding UpdateVisibility}" ToolTip="{Binding UpdateToolTip}" MouseLeftButtonUp="OpenNexusUpdate_Click" />
										</StackPanel>

										<TextBlock Grid.Column="2" Text="{Binding Status}" Margin="0,0,10,0" VerticalAlignment="Center" MaxWidth="480" TextTrimming="CharacterEllipsis">
											<TextBlock.Style>
												<Style TargetType="{x:Type TextBlock}">
													<Setter Property="Foreground" Value="{DynamicResource FaintTextBrush}" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding StatusKind}" Value="pending">
															<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
															<Setter Property="FontWeight" Value="SemiBold" />
														</DataTrigger>
														<DataTrigger Binding="{Binding StatusKind}" Value="problem">
															<Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>
								</DataTemplate>
							</ListView.Resources>
						</utils:ListViewEx>

					</Grid>

					<Grid Grid.Row="2" Margin="0,8,0,0">
						<TextBlock x:Name="StatusMessage" Opacity="0" Text="" VerticalAlignment="Center" Margin="2,0,600,0" TextTrimming="CharacterEllipsis" MouseLeftButtonUp="StatusMessage_MouseLeftButtonUp" />

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
							<TextBlock x:Name="PendingLabel" Text="" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
							<Button x:Name="RevertButton" Content="Revert" Width="80" Height="26" Margin="0,0,6,0" IsEnabled="False" ToolTip="Set the ticks back to what's installed" Click="RevertButton_Click" />
							<Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource AccentButton}" Width="100" Height="26" Margin="0,0,16,0" IsEnabled="False" Click="ApplyButton_Click" />
							<Button Content="Import from game..." Width="130" Height="26" Margin="0,0,6,0" ToolTip="Add mods already in the game folder (nothing is copied)" Click="ImportMods_Click" />
							<Button Content="Launch game" Width="110" Height="26" Click="LaunchGameButton_Click" />
						</StackPanel>
					</Grid>
				</Grid>
			</TabItem>

			<!-- SUITS MENU -->
			<TabItem Header="SUITS MENU" x:Name="SuitsMenuTab">
				<tabs:SuitsMenu x:Name="SuitsMenuContent" />
			</TabItem>

			<!-- SETTINGS -->
			<TabItem Header="SETTINGS">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="0,0,0,14">
						<Expander Header="GENERAL">
							<StackPanel>
								<StackPanel Style="{StaticResource SettingRow}">
									<TextBlock Text="Theme" Style="{StaticResource SettingLabel}" />
									<ComboBox x:Name="Settings_Theme" Width="160" Height="24" SelectionChanged="Settings_Theme_SelectionChanged" />
								</StackPanel>
							</StackPanel>
						</Expander>

						<Expander Header="GAME (THIS PROFILE)">
							<StackPanel>
								<StackPanel Style="{StaticResource SettingRow}">
									<TextBlock Text="Game folder" Style="{StaticResource SettingLabel}" />
									<TextBlock x:Name="Settings_GamePath" Text="" VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis" />
									<Button Content="Open" Width="70" Height="24" Margin="10,0,0,0" Click="OpenGameFolder_Click" />
								</StackPanel>
								<StackPanel Style="{StaticResource SettingRow}">
									<TextBlock Text="Version" Style="{StaticResource SettingLabel}" />
									<TextBlock x:Name="Settings_Store" Text="" VerticalAlignment="Center" />
								</StackPanel>
								<StackPanel Style="{StaticResource SettingRow}">
									<TextBlock Text="DLC folder" Style="{StaticResource SettingLabel}" />
									<ComboBox x:Name="Settings_DlcFolder" Width="120" Height="24" SelectionChanged="Settings_DlcFolder_SelectionChanged" />
									<TextBlock Text="DLC mods go into DLC\&lt;this folder&gt;." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
								</StackPanel>
							</StackPanel>
						</Expander>

						<Expander Header="BMSDK (SCRIPT MODS)">
							<StackPanel>
								<TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8">
									Script mods run on <Hyperlink NavigateUri="https://github.com/Team-BmSDK/BmSDK-AK" RequestNavigate="Hyperlink_RequestNavigate">BmSDK-AK</Hyperlink>, which only supports the Steam version of the game.
								</TextBlock>
								<StackPanel Style="{StaticResource SettingRow}">
									<TextBlock Text="Status" Style="{StaticResource SettingLabel}" />
									<TextBlock x:Name="Settings_BmSdkStatus" Text="" FontWeight="SemiBold" VerticalAlignment="Center" />
								</StackPanel>
								<Button x:Name="Settings_BmSdkInstallButton" Content="Install BmSDK" Width="170" Height="24" HorizontalAlignment="Left" Click="InstallBmSdk_Click" />
							</StackPanel>
						</Expander>

						<Expander Header="ABOUT">
							<StackPanel>
								<TextBlock x:Name="AboutText" Margin="0,0,0,4" />
								<TextBlock Style="{StaticResource Hint}">
									A fork of <Hyperlink NavigateUri="https://github.com/Tkachov/Overstrike" RequestNavigate="Hyperlink_RequestNavigate">Overstrike</Hyperlink> by Tkachov. GNU GPLv3.
								</TextBlock>
							</StackPanel>
						</Expander>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</Window>
