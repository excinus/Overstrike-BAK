<Window x:Class="OverstrikeBAK.CreateProfile"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		Title="Create new profile" Height="150" Width="700" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" Icon="pack://application:,,,/Properties/Resources/icon.ico">
	<Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}">
		<Grid>
			<Grid Height="22" Margin="7,7,7,0" VerticalAlignment="Top">
				<TextBox x:Name="NameTextBox" Text="" VerticalAlignment="Top" Height="22" Padding="1" TextChanged="NameTextBox_TextChanged" />
				<TextBlock IsHitTestVisible="False" Text="Profile Name" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="3,-1,0,0" Padding="1" Foreground="{DynamicResource FaintTextBrush}">
					<TextBlock.Style>
						<Style TargetType="{x:Type TextBlock}">
							<Setter Property="Visibility" Value="Collapsed"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding Text, ElementName=NameTextBox}" Value="">
									<Setter Property="Visibility" Value="Visible"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</Grid>

			<Grid Height="22" Margin="7,35,7,0" VerticalAlignment="Top">
				<Grid.ColumnDefinitions>
					<ColumnDefinition />
					<ColumnDefinition Width="75" />
				</Grid.ColumnDefinitions>
				<TextBox Grid.Column="0" x:Name="PathTextBox" Height="22" Margin="0,0,7,0" Text="" VerticalAlignment="Top" IsReadOnly="True" />
				<Button Grid.Column="1" Content="Browse..." VerticalAlignment="Top" Height="22" Click="BrowseButton_Click" />
			</Grid>

			<Grid VerticalAlignment="Bottom" Margin="5,0,5,5">
				<Label Foreground="{DynamicResource SubtleTextBrush}" Content="Select the 'Batman Arkham Knight' game folder." x:Name="ErrorMessage" HorizontalAlignment="Left" Margin="0,0,0,5" VerticalAlignment="Bottom"/>
				<Button Content="Create" x:Name="CreateProfileButton" IsEnabled="False" HorizontalAlignment="Right" Margin="0,0,2,5" VerticalAlignment="Bottom" Width="75" Height="22" Click="CreateProfileButton_Click" />
			</Grid>
		</Grid>
	</Border>
</Window>
